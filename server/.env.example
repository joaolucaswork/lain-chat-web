# Porta do BFF (serve o frontend + /api/*)
CHAT_PORT=3335

# lain-memory (vetores + grafo). Suba com: cd lain-memory && docker compose up -d && bun run dev
LAIN_MEMORY_URL=http://localhost:3341
# Bearer do lain-memory (mesmo valor de LAIN_API_KEY no .env dele; obrigatório)
LAIN_MEMORY_API_KEY=change-me

# LLM OpenAI-compatible (chat). LAIN_LLM_* vence; fallbacks mantidos por compat.
LAIN_LLM_BASE_URL=https://openrouter.ai/api/v1
LAIN_LLM_API_KEY=change-me
# OPENROUTER_API_KEY=change-me
#AI_GATEWAY_API_KEY=
# Modelo default do chat (o frontend pode trocar por mensagem)
LAIN_LLM_MODEL=anthropic/claude-haiku-5.5

# Escopo base do chat (escrita do remember continua aqui; default 'diario' = `lucas:diario`)
LAIN_CHAT_PROJECT=diario

# Fan-out total de leitura (Opção A): vazio = global + todos os projetos via grafo.
# Ex: LAIN_CHAT_PROJECTS=diario,global,lain-memory (allowlist; 'global' inclui o global)
#LAIN_CHAT_PROJECTS=
# Inclui global no fan-out auto ('on' default; 'off' = só projetos)
#LAIN_CHAT_INCLUDE_GLOBAL=on
# TopK por escopo no recall fan-out (default 8; total fatiado em ~20)
#LAIN_CHAT_RECALL_PER_PROJECT=8

# Supabase Cloud (só Auth). Publishable vai pro front (.env.local);
# a secret fica AQUI no server — nunca commita, nunca expõe.
#SUPABASE_URL=https://xyzcompany.supabase.co
#SUPABASE_SECRET_KEY=change-me

# Grafo automático no contexto ('on' = paralelo recall+grafo; 'off' = só on-demand via tool)
#LAIN_GRAPH_AUTO=on
